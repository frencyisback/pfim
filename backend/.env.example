# Copy this file to .env and adjust the values.

# Isolated development path (relative to the backend/ directory).
# The operational pfim.db file must never be the default for a new setup.
DATABASE_URL=sqlite:///../data/pfim-dev.db
SQLITE_BUSY_TIMEOUT_MS=5000

APP_ENV=development
APP_NAME=PFIM
API_V1_PREFIX=/api/v1

# Allowed CORS origins (Vite development frontend).
CORS_ORIGINS=http://localhost:5173
BACKEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TRUSTED_HOSTS=localhost,127.0.0.1

# Operational features fail closed. Enable backup and restore only after
# setting the exact Alembic revision distributed with the build. Restore
# also requires verified modern backups and the maintenance protocol.
BACKUP_ENABLED=false
# Online copy-loop limit, including lock retries (1-600 seconds).
BACKUP_COPY_TIMEOUT_SECONDS=60
RESTORE_ENABLED=false
RESTORE_QUIESCE_TIMEOUT_SECONDS=30
EXPECTED_ALEMBIC_REVISION=
